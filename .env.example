# Copy to .env.local. With the Firebase values left blank the app runs in Demo Mode
# (data stays in this browser, AI replies are scripted and labelled, nothing is sent).

# --- Firebase web app config (public by design; access is enforced by firestore.rules / storage.rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Region the Cloud Functions are deployed to (must match functions/src)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
# "true" to use local emulators (auth 9099, firestore 8080, functions 5001, storage 9199)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# --- Optional ---
# Web Push certificate key (Firebase console → Project settings → Cloud Messaging → Web configuration)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# reCAPTCHA Enterprise site key for App Check (then set ENFORCE_APP_CHECK=true for functions)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- Server-side only (never in the web app) ---
# Vercel / Next.js server routes: real Gemini replies and Gemini Live without Firebase.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# --- Text AI providers (server-side only; any subset). A provider is used only when its key AND model are set. ---
# Adaption Labs (primary by default): OpenAI-compatible Responses API. Use a model ID enabled for YOUR account.
ADAPTION_API_KEY=
ADAPTION_MODEL=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
# Gemini model for text (defaults to GEMINI_MODEL)
AI_MODEL_GEMINI=
OPENAI_API_KEY=
AI_MODEL_OPENAI=
GROQ_API_KEY=
AI_MODEL_GROQ=
OPENROUTER_API_KEY=
AI_MODEL_OPENROUTER=
# Priority. Either a full list, or primary + fallbacks. Default: adaption,gemini,openai,groq,openrouter
AI_PROVIDER_ORDER=
AI_PRIMARY_PROVIDER=
AI_FALLBACK_PROVIDERS=
# Providers allowed to receive the elder's approved LifeBook facts. Others get Pookie's safety rules only.
AI_LIFEBOOK_PROVIDERS=adaption,gemini
# Per-request timeout (ms). One bounded retry on rate limits / 5xx / timeouts, then the next provider.
AI_TIMEOUT_MS=15000
# Turns on /api/ai/health (admin diagnostics, used on /admin). At least 16 random characters. Leave blank to disable.
ADMIN_DIAGNOSTICS_TOKEN=

# Gemini key: a Cloud Functions secret, not an env var:
#   npx firebase functions:secrets:set GEMINI_API_KEY
# Function parameters go in functions/.env (see functions/.env.example).
