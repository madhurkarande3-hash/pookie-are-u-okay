# Copy to .env.local. A normal build needs Firebase configured before it starts.
# Local demo fixtures are opt-in and never available in a production build.

# --- Firebase web app config (public by design; access is enforced by firestore.rules / storage.rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Region the Cloud Functions are deployed to (must match functions/src)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
# "true" to use local emulators (auth 9099, firestore 8080, functions 5001, storage 9199)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
# Local development only. Set to "true" to use fictional browser-only fixtures
# and clearly labelled scripted replies when Firebase is not configured.
NEXT_PUBLIC_ENABLE_DEMO_MODE=

# --- Optional ---
# Web Push certificate key (Firebase console → Project settings → Cloud Messaging → Web configuration)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# reCAPTCHA Enterprise site key for App Check (then set ENFORCE_APP_CHECK=true for functions)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- Server-side only (never in the web app) ---
# Gemini key: a Cloud Functions secret, not an env var:
#   npx firebase functions:secrets:set GEMINI_API_KEY
# Function parameters go in functions/.env (see functions/.env.example).
