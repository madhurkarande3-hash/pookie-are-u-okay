# Copy to functions/.env (deployed with the functions). No secrets here.
# Gemini text model for companionReply
GEMINI_MODEL=gemini-flash-latest
# Gemini Live (native audio) model for real-time voice
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# Require App Check on AI functions once the web app has a reCAPTCHA Enterprise key
ENFORCE_APP_CHECK=false
# "true" after installing the Firebase "Trigger Email" extension (watches the `mail` collection)
EMAIL_ENABLED=false
# Public URL of the deployed app, used in notification links and emails
APP_URL=
# Nightly Firestore export target, e.g. gs://your-project-pookie-backups (empty = off)
BACKUP_BUCKET=
