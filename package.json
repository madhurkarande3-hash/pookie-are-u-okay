{
  "name": "pookie",
  "version": "0.1.0",
  "private": true,
  "description": "Pookie — AI care and memory companion for older adults",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pookie \"vitest run -c vitest.rules.config.ts\"",
    "test:all": "npm run typecheck && npm test && npm run test:rules",
    "emulators": "firebase emulators:start --project demo-pookie",
    "deploy": "firebase deploy --only firestore,functions",
    "build:single": "vite build -c web-single/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/nunito": "^5.2.5",
    "@google/genai": "^3.3.0",
    "firebase": "^12.0.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "firebase-tools": "^14.27.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.4"
  }
}
